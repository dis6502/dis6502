<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>com.wudsn.tools</groupId>
	<artifactId>com.wudsn.tools.dis6502</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<packaging>jar</packaging>

	<name>dis6502</name>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.source>1.8</maven.compiler.source>
		<maven.compiler.target>1.8</maven.compiler.target>
	</properties>

	<dependencies>
		<dependency>
			<groupId>com.wudsn.tools</groupId>
			<artifactId>com.wudsn.tools.base</artifactId>
			<version>1.0.0-SNAPSHOT</version>
		</dependency>
		<dependency>
			<groupId>com.wudsn.tools</groupId>
			<artifactId>com.wudsn.tools.base.atari</artifactId>
			<version>1.0.0-SNAPSHOT</version>
		</dependency>
		<!-- org.eclipse.osgi.util.NLS: the same standalone text-repository mechanism
		     used by com.wudsn.tools.base.hello.standalone's Texts.java, used here by
		     Text.java. Used purely as a plain library class - no OSGi runtime/container
		     is involved. -->
		<dependency>
			<groupId>org.eclipse.platform</groupId>
			<artifactId>org.eclipse.osgi</artifactId>
			<version>3.21.0</version>
		</dependency>
	</dependencies>

	<build>
		<finalName>dis6502</finalName>
		<sourceDirectory>src</sourceDirectory>
		<testSourceDirectory>test</testSourceDirectory>
		<resources>
			<resource>
				<directory>src</directory>
				<excludes>
					<exclude>**/*.java</exclude>
				</excludes>
			</resource>
		</resources>
		<plugins>
			<!-- Merges this project's classes with com.wudsn.tools.base(.atari) into a
			     single runnable jar. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<version>3.5.3</version>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<!-- org.eclipse.osgi is a signed jar; merging its META-INF
							     signature files into this uber-jar without stripping them
							     leaves a manifest the JVM's jar verifier rejects at
							     runtime ("Invalid signature file digest for Manifest main
							     attributes"), since the merged jar's content no longer
							     matches the original signature. -->
							<filters>
								<filter>
									<artifact>*:*</artifact>
									<excludes>
										<exclude>META-INF/*.SF</exclude>
										<exclude>META-INF/*.DSA</exclude>
										<exclude>META-INF/*.RSA</exclude>
									</excludes>
								</filter>
							</filters>
							<transformers>
								<transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
									<mainClass>com.wudsn.tools.dis6502.Dis6502</mainClass>
								</transformer>
							</transformers>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
