<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>com.wudsn.tools</groupId>
	<artifactId>com.wudsn.tools.dis6502</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<packaging>jar</packaging>

	<name>dis6502</name>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.release>21</maven.compiler.release>
		<!-- Set to true to skip the tests that need a display (see DialogTextsTest.isHeadless). -->
		<dis6502.skipUITests>false</dis6502.skipUITests>
	</properties>

	<dependencies>
		<dependency>
			<groupId>com.wudsn.tools</groupId>
			<artifactId>com.wudsn.tools.base</artifactId>
			<version>1.0.0-SNAPSHOT</version>
		</dependency>
		<dependency>
			<groupId>com.wudsn.tools</groupId>
			<artifactId>com.wudsn.tools.base.atari</artifactId>
			<version>1.0.0-SNAPSHOT</version>
		</dependency>
		<!-- Only for TestRunnerTest, the one-method bridge that lets Surefire run TestRunner;
		     the tests themselves use no framework (see TestRunner's javadoc). -->
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<version>3.8.1</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<finalName>dis6502</finalName>
		<sourceDirectory>src</sourceDirectory>
		<testSourceDirectory>test</testSourceDirectory>
		<resources>
			<resource>
				<directory>src</directory>
				<excludes>
					<exclude>**/*.java</exclude>
				</excludes>
			</resource>
		</resources>
		<plugins>
			<!-- Runs the whole suite through TestRunnerTest on every build ("mvn test"/"package").
			     Pinned to a version whose JUnit 3 provider is in the offline repository. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.2.5</version>
				<configuration>
					<includes>
						<include>**/TestRunnerTest.java</include>
					</includes>
					<systemPropertyVariables>
						<dis6502.skipUITests>${dis6502.skipUITests}</dis6502.skipUITests>
					</systemPropertyVariables>
				</configuration>
			</plugin>
			<!-- Merges this project's classes with com.wudsn.tools.base(.atari) into a
			     single runnable jar. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<version>3.5.3</version>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<transformers>
								<transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
									<mainClass>com.wudsn.tools.dis6502.Dis6502</mainClass>
								</transformer>
							</transformers>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
